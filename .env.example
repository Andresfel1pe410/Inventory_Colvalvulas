# =============================================
# ERP Inventario - Variables de entorno
# Copiar a .env (raíz) para backend y frontend/.env para frontend
# =============================================

# ---------- BACKEND (FastAPI) - archivo .env en raíz ----------
# Base de datos PostgreSQL (Supabase)
# IMPORTANTE para varios usuarios: usa el connection pooler (puerto 6543).
# En Supabase: Settings -> Database -> Connection string -> "Transaction" (pooler)
# Formato pooler: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-XX.pooler.supabase.com:6543/postgres
# Formato directo: postgresql://postgres:[PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.xxxxxxxx.supabase.co:5432/postgres

# Supabase - Backend
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key - NUNCA exponer en frontend, solo en backend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret (opcional) - Si JWKS falla, usa esto para verificar con HS256
# En Supabase: Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# CORS - Orígenes permitidos (separados por coma). Obligatorio en producción.
# Ejemplo: https://inventory-colvalvulas.vercel.app,http://localhost:5173
CORS_ORIGINS=https://inventory-colvalvulas.vercel.app

# Concurrencia (opcionales; valores por defecto pensados para 1 worker).
# El número de workers de uvicorn se controla con WEB_CONCURRENCY (por defecto 1).
# THREADPOOL_SIZE=40     # hilos para endpoints `def` simultáneos
# DB_POOL_SIZE=10        # conexiones a la BD por worker
# DB_MAX_OVERFLOW=10     # conexiones extra en picos
# DB_POOL_TIMEOUT=30     # segundos esperando una conexión libre

# Endpoints /api/v1/auth/debug/* para diagnosticar el login. Solo en local.
# DEBUG_ENDPOINTS=true

# ---------- FRONTEND (React/Vite) - archivo frontend/.env ----------
# Vite usa prefijo VITE_ para exponer variables al cliente
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL del backend API (solo en producción, ej. Vercel)
# En desarrollo se usa ruta relativa /api/v1 (proxy de Vite)
# Ejemplo: VITE_API_URL=https://inventario-colvalvulas.up.railway.app
VITE_API_URL=
