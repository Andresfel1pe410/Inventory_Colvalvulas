# =============================================
# ERP Inventario - Variables de entorno
# Copiar a .env (raíz) para backend y frontend/.env para frontend
# =============================================

# ---------- BACKEND (FastAPI) - archivo .env en raíz ----------
# Base de datos PostgreSQL (Supabase)
# Formato: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.xxxxxxxx.supabase.co:5432/postgres

# Supabase - Backend
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key - NUNCA exponer en frontend, solo en backend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret (opcional) - Si JWKS falla, usa esto para verificar con HS256
# En Supabase: Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# CORS - Orígenes permitidos (separados por coma). Obligatorio en producción.
# Ejemplo: https://inventory-colvalvulas.vercel.app,http://localhost:5173
CORS_ORIGINS=https://inventory-colvalvulas.vercel.app

# ---------- FRONTEND (React/Vite) - archivo frontend/.env ----------
# Vite usa prefijo VITE_ para exponer variables al cliente
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL del backend API (solo en producción, ej. Vercel)
# En desarrollo se usa ruta relativa /api/v1 (proxy de Vite)
# Ejemplo: VITE_API_URL=https://inventario-colvalvulas.up.railway.app
VITE_API_URL=
