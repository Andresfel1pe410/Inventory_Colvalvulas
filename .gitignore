# =============================================
# ERP Inventario - .gitignore
# Seguridad: NUNCA commitear archivos con credenciales
# =============================================

# ---------- Variables de entorno (CRÍTICO) ----------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.env

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.eggs/
*.egg-info/
*.egg
dist/
build/
*.manifest

# ---------- Node / Frontend ----------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn-integrity

# Build outputs
frontend/dist/
*.tsbuildinfo

# ---------- IDE / Editor ----------
.idea/
.vscode/
Untitled
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------- Sistema operativo ----------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Logs y temporales ----------
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.bak
*.cache

# ---------- Base de datos local ----------
*.db
*.sqlite
*.sqlite3

# ---------- Supabase local (si se usa CLI) ----------
.supabase/

# ---------- Testing / Coverage ----------
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/
coverage/
*.cover
.hypothesis/

# ---------- Otros sensibles ----------
*.pem
*.key
secrets/
credentials/
*.credentials
.aider*
